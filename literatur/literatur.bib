	keywords = {{AI}, {AI} development, {AI} operations, artificial intelligence, Artificial intelligence, Business, business {AI}, business applications, enterprise {AI}, Enterprise resource planning, {ERP}, Fraud, generative {AI}, Generative {AI}, Libraries, Manufacturing, Prevention and mitigation, Software, software integration, Taxonomy},
